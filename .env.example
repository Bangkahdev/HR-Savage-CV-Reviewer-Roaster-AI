# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# Get one from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this app is hosted.
APP_URL="http://localhost:3000"

# ALLOWED_ORIGINS: Optional comma-separated list of allowed CORS origins.
# Leave empty to reflect the request origin (works for Vercel previews).
# Example: ALLOWED_ORIGINS="https://your-app.vercel.app,http://localhost:3000"
ALLOWED_ORIGINS=""

# NODE_ENV: development | production
NODE_ENV="development"
