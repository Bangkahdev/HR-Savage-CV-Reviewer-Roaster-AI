    "canvas-confetti": "^1.9.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.427.0",
    "motion": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.21.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.16.0",
    "typescript": "~5.5.0",
    "vite": "^5.4.0"
  }
