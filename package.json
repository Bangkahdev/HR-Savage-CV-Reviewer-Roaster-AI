{
  "name": "hr-savage-cv-reviewer-roaster-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "HR Savage CV Reviewer & Roaster AI - Soft-styled AI-powered CV audit & roasting platform",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
